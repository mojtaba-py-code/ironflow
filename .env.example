# IronFlow environment template.
# Copy to .env and fill in. Never commit .env - it is in .gitignore for a reason.

# ---------------------------------------------------------------- identity --
IRONFLOW_ENVIRONMENT=local          # local | development | staging | production
IRONFLOW_SERVICE_NAME=ironflow

# ----------------------------------------------------------------- logging --
IRONFLOW_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR | CRITICAL
IRONFLOW_LOG_JSON=false             # true in production so the shipper can parse it
# IRONFLOW_LOG_FILE=./.ironflow/logs/ironflow.log

# ------------------------------------------------------------------- paths --
IRONFLOW_HOME=./.ironflow
IRONFLOW_PIPELINES_DIR=./pipelines

# Directories connectors may read and write. Comma-separated or a JSON array.
# REQUIRED in production: without it a pipeline file can read any path the
# process can reach.
IRONFLOW_DATA_ROOTS=./data

# ----------------------------------------------------------- state database --
# Defaults to SQLite under IRONFLOW_HOME. Production must use a server database:
# SQLite cannot serve concurrent workers safely.
# IRONFLOW_STATE_DATABASE_URL=postgresql+psycopg://ironflow:***@db:5432/ironflow
IRONFLOW_STATE_POOL_SIZE=5
IRONFLOW_STATE_MAX_OVERFLOW=10

# --------------------------------------------------------------- execution --
IRONFLOW_DEFAULT_BATCH_SIZE=10000
IRONFLOW_MAX_PARALLEL_TASKS=4
IRONFLOW_TASK_TIMEOUT=3600
IRONFLOW_CHECKPOINT_ENABLED=true

# ---------------------------------------------------------------- security --
# Generate with: ironflow secrets generate-key
# IRONFLOW_ENCRYPTION_KEY=

# API authentication. Both are REQUIRED in production.
IRONFLOW_AUTH_ENABLED=false
# IRONFLOW_JWT_SECRET=            # at least 32 characters
IRONFLOW_JWT_ISSUER=ironflow
IRONFLOW_JWT_AUDIENCE=ironflow-api

# Set false in production: it forces every secret to come from env:/file:/enc:.
IRONFLOW_ALLOW_LITERAL_SECRETS=true

# Leave false: it is the SSRF guard. Enable only to reach an internal API, and
# prefer an explicit `allowed_hosts` on that connector instead.
IRONFLOW_ALLOW_PRIVATE_NETWORK=false

IRONFLOW_AUDIT_ENABLED=true
IRONFLOW_MASK_PII_IN_REPORTS=true

# -------------------------------------------------------------------- http --
IRONFLOW_HTTP_TIMEOUT=30
IRONFLOW_HTTP_VERIFY_TLS=true       # never false in production
IRONFLOW_HTTP_MAX_RESPONSE_BYTES=268435456

# --------------------------------------------------------------------- api --
IRONFLOW_API_HOST=127.0.0.1         # 0.0.0.0 only behind a proxy, with auth on
IRONFLOW_API_PORT=8080
# IRONFLOW_API_CORS_ORIGINS=https://ops.example.com

# ------------------------------------------------- data-source credentials --
# Referenced from pipeline files as env:NAME - never inline the value there.
# PGPASSWORD=
# SFTP_PASSWORD=
# API_TOKEN=
# SLACK_WEBHOOK_URL=

# Keyed HMAC for `hash_columns`, used by the bundled sales_daily pipeline.
# Generate with: openssl rand -base64 32
# Changing it changes every token, so downstream joins break - rotate it the
# way you would rotate a database key, not casually.
# IRONFLOW_HASH_KEY=
